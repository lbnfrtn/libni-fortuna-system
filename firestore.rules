rules_version = '2';
// The Libni Fortuna system talks to Firestore only through the server (the
// Firebase Admin SDK, which BYPASSES these rules). No browser ever reads or
// writes orders directly. So we deny all client access outright — orders hold
// payment data and must never be reachable from the client.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
