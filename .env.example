# ============================================================================
# Libni Fortuna System — environment configuration
# Copy this file to `.env.local` and fill in. NEVER commit .env.local.
# ============================================================================
#
# You can run and test the ENTIRE system locally with NOTHING filled in here.
# In that state it runs in MOCK MODE: a fake Xendit checkout, a GHL that only
# logs what it would send, and orders saved to /data on disk. Fill things in
# one at a time to connect the real services.
# ----------------------------------------------------------------------------

# --- Mode -------------------------------------------------------------------
# "test" = safe. Uses Xendit TEST keys (or full mock if none). No real money.
# "live" = real money. Only set this the day we go live, together.
APP_MODE=test

# The public base URL of THIS app. Local default shown. On Vercel this becomes
# your real domain. Used to build payment success/redirect + welcome links.
APP_BASE_URL=http://localhost:4310

# --- Payment Desk login (Section 7.3) --------------------------------------
# Emails allowed into /desk, comma-separated. First = owner, rest = assistant.
DESK_OWNER_EMAIL=hello@libni.co
DESK_ASSISTANT_EMAILS=
# A shared passcode for the Desk in test mode (simple gate; replace with
# Firebase Auth before go-live if you want per-person logins). Leave blank to
# disable the gate entirely while testing on your own machine.
DESK_PASSCODE=

# --- Xendit (payments) ------------------------------------------------------
# Get from Xendit -> Settings -> Developers -> API keys. Use the TEST key first
# (toggle top-right of the Xendit dashboard). Leave BLANK to run in full mock
# mode with a fake local checkout page.
XENDIT_SECRET_KEY=
# Xendit -> Settings -> Developers -> Webhooks -> verification token.
# This is the SAME token used by Project Me (same account). That's fine — our
# webhook only acts on orders whose id starts with "LF-".
XENDIT_WEBHOOK_TOKEN=

# --- GoHighLevel (CRM) ------------------------------------------------------
# A Private Integration token for the location. Leave BLANK to run with a GHL
# that only logs what it would send (nothing is written to your real CRM).
GHL_API_TOKEN=
GHL_LOCATION_ID=8gAGOfERvVoKqReLLEmc
# GHL API version header. Do not change unless GHL's docs say to.
GHL_API_VERSION=2021-07-28

# --- Manual bank transfer (Section 7.5) ------------------------------------
# Shown on the manual-transfer fallback page. Placeholders are fine for
# testing; put the real details in before go-live.
BANK_NAME=BPI (placeholder)
BANK_ACCOUNT_NAME=Libni Fortuna (placeholder)
BANK_ACCOUNT_NUMBER=0000-0000-00 (placeholder)

# --- Storage ----------------------------------------------------------------
# "file" = JSON files under /data (local dev/test). "firestore" = production.
ORDER_STORE=file
# If ORDER_STORE=firestore, paste the service-account JSON path or JSON blob.
FIREBASE_SERVICE_ACCOUNT=
FIREBASE_PROJECT_ID=

# --- Notifications (who to tell when money moves) ---------------------------
# Where "you got paid" / "proof submitted" internal alerts go. In test mode
# these are just logged. Wired to GHL/email at go-live.
NOTIFY_OWNER_EMAIL=hello@libni.co
NOTIFY_ASSISTANT_EMAIL=

# Live Instagram posts above the footer (optional). A long-lived Instagram
# Graph API token (Instagram Login) — Meta for Developers → your app →
# Instagram → Generate token. Lasts 60 days; refresh before it expires.
# Without it, the strip shows the photos from the Studio's "Instagram" slots.
INSTAGRAM_ACCESS_TOKEN=
